# Public Supabase configuration (safe in browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST mode during development
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Optional interchangeable AI provider (no provider = deterministic mode)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quota and crawler configuration
FREE_MAX_WEBSITES=1
FREE_MAX_ANALYSES=3
FREE_MAX_PAGES=1
PRO_MAX_WEBSITES=10
PRO_MAX_ANALYSES=50
PRO_MAX_PAGES=10
BUSINESS_MAX_WEBSITES=50
BUSINESS_MAX_ANALYSES=200
BUSINESS_MAX_PAGES=25
CRAWLER_TIMEOUT=8000
CRAWLER_MAX_PAGES=10
CRAWLER_MAX_RESPONSE_SIZE=2000000
CRAWLER_MAX_LINKS=80
CRAWLER_MAX_REDIRECTS=3
CRAWLER_MAX_TOTAL_TIME=20000
